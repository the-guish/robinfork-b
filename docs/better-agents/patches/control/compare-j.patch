Subject: [PATCH] Test that every HTTP answer carries the security headers

Covers API answers, the guard's and the routes' refusals (403, 401, 404,
422), the redirect to the interface, and the interface's files, built
or not.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EdaMv891NCzHKUE2B1MtSL
Signed-off-by: Claude <noreply@anthropic.com>
---
 .../tests/fast/test_web_security_headers.py   | 124 ++++++++++++++++++
 1 file changed, 124 insertions(+)
 create mode 100644 backend/tests/fast/test_web_security_headers.py

diff --git a/backend/tests/fast/test_web_security_headers.py b/backend/tests/fast/test_web_security_headers.py
new file mode 100644
index 0000000..eebde33
--- /dev/null
+++ b/backend/tests/fast/test_web_security_headers.py
@@ -0,0 +1,124 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries the security headers: an API answer, a refusal from the guard, a
+refusal from a route, an answer for a path nobody serves, a redirect, and the files of the
+interface, built or not."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import httpx
+import pytest
+from echo_controller import CONFIG
+
+from robinauts.controller.composition import compose
+from robinauts.controller.contract.domain import StorageConfig, StorageKind
+from robinauts.web.app import create_app
+from robinauts.web.cookies import Cookies
+from robinauts.web.headers import SECURITY_HEADERS
+from robinauts.web.sign_in import AllowEntry, Matcher, ProviderConfig, SignInConfig
+from util.aio import asyncio_test
+
+PUBLIC_URL = "https://robinauts.example.com"
+SIGN_IN = SignInConfig(
+    public_url=PUBLIC_URL,
+    providers={
+        "okta": ProviderConfig(
+            id="okta",
+            title="Okta",
+            issuer="https://example.okta.com/oauth2/default",
+            client_id="robinauts",
+            client_secret_env="ROBINAUTS_OKTA_SECRET",
+        )
+    },
+    allow=(AllowEntry("okta", Matcher.EVERYONE, None),),
+)
+
+
+@asynccontextmanager
+async def client(
+    *, sign_in: SignInConfig | None, base_url: str, ui_dir: Path | None = None
+) -> AsyncIterator[httpx.AsyncClient]:
+    composed = compose(CONFIG, storage=StorageConfig(StorageKind.IN_MEMORY), secret_for={}.get)
+    app = create_app(composed, sign_in=sign_in, secret_for={}.get, ui_dir=ui_dir)
+    async with app.router.lifespan_context(app):
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url=base_url) as http:
+            yield http
+
+
+def assert_secured(answer: httpx.Response) -> None:
+    for name, value in SECURITY_HEADERS:
+        assert answer.headers.get_list(name) == [value], (answer.request.url, name)
+
+
+@asyncio_test
+async def test_local_answers_and_refusals_carry_the_headers() -> None:
+    async with client(sign_in=None, base_url="http://localhost") as http:
+        answers = {
+            "api": await http.get("/api/agents"),
+            "health": await http.get("/health"),
+            "redirect": await http.get("/"),
+            "unbuilt interface": await http.get("/ui/"),
+            "unknown path": await http.get("/api/nowhere"),
+            "unknown conversation": await http.get(
+                "/api/conversations/00000000-0000-0000-0000-000000000000"
+            ),
+            "invalid body": await http.post("/api/turns", json={}),
+            "foreign host": await http.get("/api/agents", headers={"host": "evil.example.com"}),
+            "foreign origin": await http.post(
+                "/api/turns", json={}, headers={"origin": "https://evil.example.com"}
+            ),
+        }
+    assert answers["api"].status_code == 200
+    assert answers["health"].status_code in (200, 503)
+    assert answers["redirect"].status_code == 307
+    assert answers["unbuilt interface"].status_code == 200
+    assert answers["unknown path"].status_code == 404
+    assert answers["unknown conversation"].status_code == 404
+    assert answers["invalid body"].status_code == 422
+    assert answers["foreign host"].status_code == 403
+    assert answers["foreign origin"].status_code == 403
+    for answer in answers.values():
+        assert_secured(answer)
+
+
+@asyncio_test
+async def test_signed_in_refusals_carry_the_headers() -> None:
+    async with client(sign_in=SIGN_IN, base_url=PUBLIC_URL) as http:
+        not_signed_in = await http.get("/api/agents")
+        unknown_token = await http.get("/api/agents", headers={"authorization": "Bearer nope"})
+        cross_origin = await http.post(
+            "/auth/logout",
+            headers={
+                "cookie": f"{Cookies(PUBLIC_URL).session}=x",
+                "origin": "https://evil.example",
+            },
+        )
+    assert not_signed_in.status_code == 401
+    assert unknown_token.status_code == 401
+    assert cross_origin.status_code == 403
+    for answer in (not_signed_in, unknown_token, cross_origin):
+        assert_secured(answer)
+
+
+@pytest.mark.io
+@asyncio_test
+async def test_the_files_of_the_interface_carry_the_headers(tmp_path: Path) -> None:
+    (tmp_path / "index.html").write_text("<!doctype html><title>Robinauts</title>")
+    (tmp_path / "assets").mkdir()
+    (tmp_path / "assets" / "app.js").write_text("console.log('hi')")
+    async with client(sign_in=None, base_url="http://localhost", ui_dir=tmp_path) as http:
+        index = await http.get("/ui/")
+        script = await http.get("/ui/assets/app.js")
+        missing = await http.get("/ui/assets/missing.js")
+    assert index.status_code == 200
+    assert "Robinauts" in index.text
+    assert script.status_code == 200
+    assert missing.status_code == 404
+    for answer in (index, script, missing):
+        assert_secured(answer)

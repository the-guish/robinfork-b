From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 17:07:02 +0000
Subject: [PATCH] Test the security headers on every HTTP answer

API answers, redirects, the guard's Host and Origin refusals, a route's
own refusal, a validation error, an unknown path, and the interface,
both unbuilt and served from a directory (its files, a missing file and
a refused request inside the mount), each carry SECURITY_HEADERS once.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EdaMv891NCzHKUE2B1MtSL
Signed-off-by: Claude <noreply@anthropic.com>
---
 .../tests/fast/test_web_security_headers.py   | 113 ++++++++++++++++++
 1 file changed, 113 insertions(+)
 create mode 100644 backend/tests/fast/test_web_security_headers.py

diff --git a/backend/tests/fast/test_web_security_headers.py b/backend/tests/fast/test_web_security_headers.py
new file mode 100644
index 0000000..86238ce
--- /dev/null
+++ b/backend/tests/fast/test_web_security_headers.py
@@ -0,0 +1,113 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries ``SECURITY_HEADERS``: an API answer, a redirect, a refusal from
+the ``Host`` and ``Origin`` guard, a refusal from a route, a path nothing serves, and the files
+of the interface, built or not. Over the web app in the local development mode, on the memory
+storage."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import httpx
+import pytest
+from echo_controller import CONFIG
+
+from robinauts.controller.composition import compose
+from robinauts.controller.contract.domain import StorageConfig, StorageKind
+from robinauts.web.app import create_app
+from robinauts.web.headers import SECURITY_HEADERS
+from util.aio import asyncio_test
+
+LOCAL = "http://127.0.0.1:8000"
+TURN = {"agent_id": "echo", "text": "hello"}
+
+
+@asynccontextmanager
+async def local(ui_dir: Path | None = None) -> AsyncIterator[httpx.AsyncClient]:
+    """The app in the local development mode, and a client that follows no redirect."""
+    composed = compose(CONFIG, storage=StorageConfig(StorageKind.IN_MEMORY), secret_for={}.get)
+    app = create_app(composed, sign_in=None, secret_for={}.get, ui_dir=ui_dir)
+    async with app.router.lifespan_context(app):
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url=LOCAL) as http:
+            yield http
+
+
+def assert_secured(answer: httpx.Response) -> None:
+    for name, value in SECURITY_HEADERS:
+        assert answer.headers.get_list(name) == [value], (answer.request.url, name)
+
+
+@asyncio_test
+async def test_api_answers_and_refusals_carry_the_security_headers() -> None:
+    async with local() as http:
+        listed = await http.get("/api/conversations")
+        assert listed.status_code == 200
+        assert_secured(listed)
+
+        redirected = await http.get("/")
+        assert redirected.status_code == 307
+        assert_secured(redirected)
+
+        # The guard answers before any route: the Host is a name, so it may be rebound.
+        rebound = await http.get("/api/conversations", headers={"host": "evil.example.com"})
+        assert rebound.status_code == 403
+        assert rebound.json()["error"] == "Forbidden"
+        assert_secured(rebound)
+
+        elsewhere = await http.post("/api/turns", json=TURN, headers={"origin": "http://evil"})
+        assert elsewhere.status_code == 403
+        assert_secured(elsewhere)
+
+        # A refusal of a route's own: no such conversation.
+        missing = await http.get("/api/conversations/00000000-0000-0000-0000-000000000000")
+        assert missing.status_code == 404
+        assert_secured(missing)
+
+        malformed = await http.post("/api/turns", json={})
+        assert malformed.status_code == 422
+        assert_secured(malformed)
+
+        nowhere = await http.get("/no/such/path")
+        assert nowhere.status_code == 404
+        assert_secured(nowhere)
+
+
+@asyncio_test
+async def test_the_unbuilt_interface_carries_the_security_headers() -> None:
+    async with local() as http:
+        page = await http.get("/ui/")
+        assert page.status_code == 200
+        assert "not built" in page.text
+        assert_secured(page)
+
+        refused = await http.get("/ui/", headers={"host": "evil.example.com"})
+        assert refused.status_code == 403
+        assert_secured(refused)
+
+
+@pytest.mark.io
+@asyncio_test
+async def test_the_files_of_the_interface_carry_the_security_headers(tmp_path: Path) -> None:
+    (tmp_path / "index.html").write_text("<!doctype html><title>Robinauts</title>")
+    (tmp_path / "assets").mkdir()
+    (tmp_path / "assets" / "app.js").write_text("console.log('robinauts')")
+    async with local(tmp_path) as http:
+        for path in ("/ui/", "/ui/index.html", "/ui/assets/app.js"):
+            served = await http.get(path)
+            assert served.status_code == 200, path
+            assert_secured(served)
+
+        absent = await http.get("/ui/assets/absent.js")
+        assert absent.status_code == 404
+        assert_secured(absent)
+
+        # The guard reaches the mounted interface too.
+        refused = await http.get("/ui/assets/app.js", headers={"host": "evil.example.com"})
+        assert refused.status_code == 403
+        assert refused.json()["error"] == "Forbidden"
+        assert_secured(refused)

Date: Sat, 10 Oct 2026 17:23:45 +0000
Subject: [PATCH] web: test that every answer carries the security headers

The API's answers, a streamed turn, the guard's refusals, a route's,
validation's and the router's, a redirect, the stand-in page and the
files of a built interface all carry SECURITY_HEADERS, once each.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EdaMv891NCzHKUE2B1MtSL
---
 .../tests/fast/test_web_security_headers.py   | 79 +++++++++++++++++++
 1 file changed, 79 insertions(+)
 create mode 100644 backend/tests/fast/test_web_security_headers.py

diff --git a/backend/tests/fast/test_web_security_headers.py b/backend/tests/fast/test_web_security_headers.py
new file mode 100644
index 0000000..a020688
--- /dev/null
+++ b/backend/tests/fast/test_web_security_headers.py
@@ -0,0 +1,79 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries ``SECURITY_HEADERS``: an answer of the API, a streamed turn, a
+refusal of every kind, a redirect and the files of the interface, built or not."""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import httpx
+from echo_controller import CONFIG
+
+from robinauts.controller.composition import compose
+from robinauts.controller.contract.domain import StorageConfig, StorageKind
+from robinauts.web.app import create_app
+from robinauts.web.headers import SECURITY_HEADERS
+from util.aio import asyncio_test
+
+
+@asynccontextmanager
+async def client(ui_dir: Path | None = None) -> AsyncIterator[httpx.AsyncClient]:
+    composed = compose(CONFIG, storage=StorageConfig(StorageKind.IN_MEMORY), secret_for={}.get)
+    app = create_app(composed, sign_in=None, secret_for={}.get, ui_dir=ui_dir)
+    async with app.router.lifespan_context(app):
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://127.0.0.1") as http:
+            yield http
+
+
+def assert_secured(response: httpx.Response, status: int) -> None:
+    assert response.status_code == status, (response.request.url, response.text)
+    for name, value in SECURITY_HEADERS:
+        assert response.headers.get_list(name) == [value], (response.request.url, name)
+
+
+@asyncio_test
+async def test_the_answers_of_the_api_and_its_refusals_carry_the_security_headers() -> None:
+    async with client() as http:
+        assert_secured(await http.get("/health"), 200)
+        assert_secured(await http.get("/api/conversations"), 200)
+        assert_secured(await http.get("/"), 307)
+        streamed = await http.post("/api/turns", json={"agent_id": "echo", "text": "hello"})
+        assert_secured(streamed, 200)
+        assert streamed.headers["content-type"].startswith("text/event-stream")
+
+        # Refused before any route: by the guard, for a host that is not local.
+        assert_secured(await http.get("/api/conversations", headers={"host": "evil.example"}), 403)
+        assert_secured(await http.get("/ui/", headers={"host": "evil.example"}), 403)
+        origin = {"origin": "http://evil.example"}
+        assert_secured(await http.post("/api/turns", json={}, headers=origin), 403)
+        # Refused by a route, by validation and by the router.
+        assert_secured(await http.get(f"/api/conversations/{uuid.uuid4()}"), 404)
+        assert_secured(await http.post("/api/turns", json={"text": 1}), 422)
+        assert_secured(await http.get("/nowhere"), 404)
+        assert_secured(await http.delete("/health"), 405)
+
+        # The page standing in for an interface that is not built.
+        assert_secured(await http.get("/ui/"), 200)
+
+
+@asyncio_test
+async def test_the_files_of_the_interface_carry_the_security_headers(tmp_path: Path) -> None:
+    (tmp_path / "index.html").write_text("<!doctype html><title>Robinauts</title>")
+    (tmp_path / "assets").mkdir()
+    (tmp_path / "assets" / "app.js").write_text("console.log('robinauts')")
+    async with client(tmp_path) as http:
+        page = await http.get("/ui/")
+        assert_secured(page, 200)
+        assert page.text.startswith("<!doctype html>")
+        assert_secured(await http.get("/ui/index.html"), 200)
+        script = await http.get("/ui/assets/app.js")
+        assert_secured(script, 200)
+        assert "javascript" in script.headers["content-type"]
+        assert_secured(await http.get("/ui/assets/missing.js"), 404)
+        assert_secured(await http.get("/ui/", headers={"host": "evil.example"}), 403)

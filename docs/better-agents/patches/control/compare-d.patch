From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 17:24:25 +0000
Subject: [PATCH] Test the security headers on every HTTP answer

An API answer, a stream, a redirect, the guard's refusals of a Host
and of an Origin, the controller's, FastAPI's 404, 405 and 422, the
sign-in refusals, and the files of the interface, built or not.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EdaMv891NCzHKUE2B1MtSL
Signed-off-by: Claude <noreply@anthropic.com>
---
 .../tests/fast/test_web_security_headers.py   | 147 ++++++++++++++++++
 1 file changed, 147 insertions(+)
 create mode 100644 backend/tests/fast/test_web_security_headers.py

diff --git a/backend/tests/fast/test_web_security_headers.py b/backend/tests/fast/test_web_security_headers.py
new file mode 100644
index 0000000..d429cd1
--- /dev/null
+++ b/backend/tests/fast/test_web_security_headers.py
@@ -0,0 +1,147 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries ``SECURITY_HEADERS``: an API answer, a stream, a redirect, the
+refusals of the guard, of the exception handlers and of FastAPI itself, and the files of the
+interface. Over the web app on the echo engine and the in-memory store."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import httpx
+import pytest
+from echo_controller import CONFIG
+
+from robinauts.controller.composition import compose
+from robinauts.controller.contract.domain import StorageConfig, StorageKind
+from robinauts.web.app import create_app
+from robinauts.web.cookies import Cookies
+from robinauts.web.headers import SECURITY_HEADERS
+from robinauts.web.sign_in import AllowEntry, Matcher, ProviderConfig, SignInConfig
+from util.aio import asyncio_test
+
+SIGN_IN = SignInConfig(
+    public_url="https://robinauts.example.com",
+    providers={
+        "okta": ProviderConfig(
+            id="okta",
+            title="Okta",
+            issuer="https://example.okta.com/oauth2/default",
+            client_id="robinauts",
+            client_secret_env="ROBINAUTS_OKTA_SECRET",
+            scopes=("openid", "email", "profile"),
+            groups_claim="groups",
+        )
+    },
+    allow=(AllowEntry("okta", Matcher.EVERYONE, None),),
+)
+
+
+@asynccontextmanager
+async def client(
+    *, sign_in: SignInConfig | None = None, ui_dir: Path | None = None
+) -> AsyncIterator[httpx.AsyncClient]:
+    secret_for = {"ROBINAUTS_OKTA_SECRET": "not-a-real-secret"}.get
+    composed = compose(CONFIG, storage=StorageConfig(StorageKind.IN_MEMORY), secret_for=secret_for)
+    app = create_app(composed, sign_in=sign_in, secret_for=secret_for, ui_dir=ui_dir)
+    async with app.router.lifespan_context(app):
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://127.0.0.1") as http:
+            yield http
+
+
+def assert_secured(answer: httpx.Response) -> None:
+    for name, value in SECURITY_HEADERS:
+        assert answer.headers.get_list(name) == [value], (answer.request.url, name)
+
+
+def test_the_policy_is_the_interfaces() -> None:
+    assert dict(SECURITY_HEADERS) == {
+        "content-security-policy": (
+            "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline';"
+            " img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none';"
+            " form-action 'none'; frame-ancestors 'none'"
+        ),
+        "x-frame-options": "DENY",
+        "x-content-type-options": "nosniff",
+        "referrer-policy": "same-origin",
+    }
+
+
+@asyncio_test
+async def test_the_answers_and_the_refusals_of_the_api_carry_them() -> None:
+    async with client() as http:
+        answers = {
+            "an answer": await http.get("/api/agents"),
+            "a stream": await http.post("/api/turns", json={"agent_id": "echo", "text": "hi"}),
+            "a redirect": await http.get("/"),
+            "the guard's refusal of a Host": await http.get(
+                "/api/agents", headers={"host": "robinauts.example.com"}
+            ),
+            "the guard's refusal of an Origin": await http.post(
+                "/api/turns",
+                json={"agent_id": "echo", "text": "hi"},
+                headers={"origin": "https://elsewhere.example.com"},
+            ),
+            "the controller's refusal": await http.get(
+                "/api/conversations/00000000-0000-0000-0000-000000000000"
+            ),
+            "a malformed request": await http.post("/api/turns", json={}),
+            "no such route": await http.get("/api/nowhere"),
+            "no such method": await http.put("/health"),
+            "the unbuilt interface": await http.get("/ui/"),
+        }
+    statuses = {what: answer.status_code for what, answer in answers.items()}
+    assert statuses == {
+        "an answer": 200,
+        "a stream": 200,
+        "a redirect": 307,
+        "the guard's refusal of a Host": 403,
+        "the guard's refusal of an Origin": 403,
+        "the controller's refusal": 404,
+        "a malformed request": 422,
+        "no such route": 404,
+        "no such method": 405,
+        "the unbuilt interface": 200,
+    }
+    for answer in answers.values():
+        assert_secured(answer)
+
+
+@asyncio_test
+async def test_a_refusal_to_sign_in_carries_them() -> None:
+    async with client(sign_in=SIGN_IN) as http:
+        not_signed_in = await http.get("/api/agents")
+        unknown_token = await http.get("/api/agents", headers={"authorization": "Bearer nope"})
+        cross_origin = await http.post(
+            "/auth/logout",
+            headers={
+                "cookie": f"{Cookies(SIGN_IN.public_url).session}=not-a-session",
+                "origin": "https://elsewhere.example.com",
+            },
+        )
+    assert not_signed_in.status_code == 401
+    assert unknown_token.status_code == 401
+    assert cross_origin.status_code == 403
+    for answer in (not_signed_in, unknown_token, cross_origin):
+        assert_secured(answer)
+
+
+@pytest.mark.io
+@asyncio_test
+async def test_the_files_of_the_interface_carry_them(tmp_path: Path) -> None:
+    (tmp_path / "index.html").write_text("<!doctype html><title>Robinauts</title>")
+    (tmp_path / "assets").mkdir()
+    (tmp_path / "assets" / "app.js").write_text("export {};\n")
+    async with client(ui_dir=tmp_path) as http:
+        answers = [
+            await http.get("/ui/"),
+            await http.get("/ui/assets/app.js"),
+            await http.get("/ui/assets/missing.js"),
+        ]
+    assert [answer.status_code for answer in answers] == [200, 200, 404]
+    for answer in answers:
+        assert_secured(answer)

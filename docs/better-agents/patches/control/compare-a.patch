From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 17:07:04 +0000
Subject: [PATCH] Test the security headers on every kind of answer

An API answer, a stream, a redirect, the Origin guard's refusals, the
exception handlers' refusals, the routing's 404, and the files of the
interface, over the app in-process on the in-memory store.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EdaMv891NCzHKUE2B1MtSL
Signed-off-by: Claude <noreply@anthropic.com>
---
 backend/tests/fast/test_web_headers.py | 88 ++++++++++++++++++++++++++
 1 file changed, 88 insertions(+)
 create mode 100644 backend/tests/fast/test_web_headers.py

diff --git a/backend/tests/fast/test_web_headers.py b/backend/tests/fast/test_web_headers.py
new file mode 100644
index 0000000..1a14580
--- /dev/null
+++ b/backend/tests/fast/test_web_headers.py
@@ -0,0 +1,88 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries the security headers: an API answer, a stream, a redirect, the
+refusals of the ``Origin`` guard and of the exception handlers, the routing's own 404, and
+the files of the interface. Marked ``io``: the interface is a page in a temporary
+directory."""
+
+from __future__ import annotations
+
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import httpx
+import pytest
+from echo_controller import CONFIG
+
+from robinauts.controller.composition import compose
+from robinauts.controller.contract.domain import StorageConfig, StorageKind
+from robinauts.web.app import create_app
+from robinauts.web.headers import SECURITY_HEADERS
+from util.aio import asyncio_test
+
+pytestmark = pytest.mark.io
+
+UNKNOWN = "00000000-0000-0000-0000-000000000000"
+
+
+@asynccontextmanager
+async def client(ui: Path) -> AsyncIterator[httpx.AsyncClient]:
+    composed = compose(CONFIG, storage=StorageConfig(StorageKind.IN_MEMORY), secret_for={}.get)
+    app = create_app(composed, sign_in=None, secret_for={}.get, ui_dir=ui)
+    async with app.router.lifespan_context(app):
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://127.0.0.1") as http:
+            yield http
+
+
+def assert_secured(answer: httpx.Response) -> None:
+    for name, value in SECURITY_HEADERS:
+        assert answer.headers.get_list(name) == [value], (answer.request.url, name)
+
+
+@asyncio_test
+async def test_every_answer_carries_the_security_headers(tmp_path: Path) -> None:
+    (tmp_path / "index.html").write_text("<!doctype html><title>Robinauts</title>")
+    (tmp_path / "app.js").write_text("console.log('robinauts')")
+    async with client(tmp_path) as http:
+        answers = {
+            "an API answer": await http.get("/api/conversations"),
+            "a stream": await http.post("/api/turns", json={"agent_id": "echo", "text": "hi"}),
+            "a redirect": await http.get("/"),
+            "the guard's refusal of a host": await http.get(
+                "/api/conversations", headers={"host": "rebound.example"}
+            ),
+            "the guard's refusal of an origin": await http.post(
+                "/api/turns",
+                json={"agent_id": "echo", "text": "hi"},
+                headers={"origin": "http://elsewhere.example"},
+            ),
+            "the guard's refusal of the interface": await http.get(
+                "/ui/", headers={"host": "rebound.example"}
+            ),
+            "a controller's refusal": await http.get(f"/api/conversations/{UNKNOWN}"),
+            "a refused body": await http.post("/api/turns", json={}),
+            "no such route": await http.get("/nowhere"),
+            "the interface's page": await http.get("/ui/"),
+            "the interface's script": await http.get("/ui/app.js"),
+            "no such file of the interface": await http.get("/ui/missing.js"),
+        }
+    statuses = {what: answer.status_code for what, answer in answers.items()}
+    assert statuses == {
+        "an API answer": 200,
+        "a stream": 200,
+        "a redirect": 307,
+        "the guard's refusal of a host": 403,
+        "the guard's refusal of an origin": 403,
+        "the guard's refusal of the interface": 403,
+        "a controller's refusal": 404,
+        "a refused body": 422,
+        "no such route": 404,
+        "the interface's page": 200,
+        "the interface's script": 200,
+        "no such file of the interface": 404,
+    }
+    for answer in answers.values():
+        assert_secured(answer)

From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 17:23:28 +0000
Subject: [PATCH] Test that every HTTP answer carries the security headers

API answers, redirects, refusals (foreign Host, foreign Origin, 404, 405,
422), a streamed turn, the interface's files and the placeholder page
when the interface is not built. The expected values are written out
from docs/specs/frontend.md rather than imported, so a change to the
policy shows up here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01EdaMv891NCzHKUE2B1MtSL
---
 .../tests/fast/test_web_security_headers.py   | 110 ++++++++++++++++++
 1 file changed, 110 insertions(+)
 create mode 100644 backend/tests/fast/test_web_security_headers.py

diff --git a/backend/tests/fast/test_web_security_headers.py b/backend/tests/fast/test_web_security_headers.py
new file mode 100644
index 0000000..5f6ed31
--- /dev/null
+++ b/backend/tests/fast/test_web_security_headers.py
@@ -0,0 +1,110 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries the security headers (``docs/specs/frontend.md``): the API's, its
+refusals, its redirects, a streamed turn, and the files of the interface and their refusals."""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import AsyncIterator
+from contextlib import asynccontextmanager
+from pathlib import Path
+
+import httpx
+import pytest
+from echo_controller import CONFIG
+
+from robinauts.controller.composition import compose
+from robinauts.controller.contract.domain import StorageConfig, StorageKind
+from robinauts.web.app import create_app
+from util.aio import asyncio_test
+
+# Written out rather than imported from robinauts.web.headers: a change to the policy is a
+# change to this test too.
+EXPECTED = {
+    "content-security-policy": (
+        "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline';"
+        " img-src 'self' data:; font-src 'self'; connect-src 'self'; base-uri 'none';"
+        " form-action 'none'; frame-ancestors 'none'"
+    ),
+    "x-frame-options": "DENY",
+    "x-content-type-options": "nosniff",
+    "referrer-policy": "same-origin",
+}
+
+FOREIGN_ORIGIN = {"origin": "https://elsewhere.example.com"}
+FOREIGN_HOST = {"host": "robinauts.example.com"}
+
+# (method, path, extra headers, the status expected, what it is)
+ANSWERS = [
+    ("GET", "/health", {}, 200, "an API answer"),
+    ("GET", "/api/agents", {}, 200, "an API answer"),
+    ("GET", "/auth/session", {}, 200, "an API answer"),
+    ("GET", "/", {}, 307, "a redirect"),
+    ("GET", "/ui", {}, 307, "a redirect"),
+    ("GET", "/ui/", {}, 200, "the interface's page"),
+    ("GET", "/ui/index.html", {}, 200, "the interface's page"),
+    ("HEAD", "/ui/", {}, 200, "the interface's page"),
+    ("GET", "/ui/assets/app.js", {}, 200, "a script of the interface"),
+    ("GET", "/ui/missing.js", {}, 404, "a file the interface does not have"),
+    ("POST", "/ui/", {}, 405, "a write to the interface"),
+    ("GET", "/ui/", FOREIGN_HOST, 403, "the interface, refused a foreign Host"),
+    ("GET", "/api/agents", FOREIGN_HOST, 403, "the API, refused a foreign Host"),
+    ("POST", "/api/turns", FOREIGN_ORIGIN, 403, "a write, refused a foreign Origin"),
+    ("GET", "/nowhere", {}, 404, "a route that does not exist"),
+    ("GET", f"/api/conversations/{uuid.uuid4()}", {}, 404, "a conversation nobody has"),
+    ("GET", "/api/conversations/not-a-uuid", {}, 422, "a malformed request"),
+    ("POST", "/api/turns", {}, 422, "a turn with no body"),
+]
+
+
+@asynccontextmanager
+async def client(ui: Path) -> AsyncIterator[httpx.AsyncClient]:
+    composed = compose(CONFIG, storage=StorageConfig(StorageKind.IN_MEMORY), secret_for={}.get)
+    app = create_app(composed, sign_in=None, secret_for={}.get, ui_dir=ui)
+    async with app.router.lifespan_context(app):
+        transport = httpx.ASGITransport(app=app)
+        async with httpx.AsyncClient(transport=transport, base_url="http://127.0.0.1") as http:
+            yield http
+
+
+@pytest.fixture
+def ui(tmp_path: Path) -> Path:
+    (tmp_path / "index.html").write_text("<!doctype html><title>Robinauts</title>")
+    (tmp_path / "assets").mkdir()
+    (tmp_path / "assets" / "app.js").write_text("export {};\n")
+    return tmp_path
+
+
+def assert_secured(response: httpx.Response) -> None:
+    carried = {name: response.headers.get(name) for name in EXPECTED}
+    assert carried == EXPECTED, f"{response.request.method} {response.request.url}"
+
+
+@asyncio_test
+async def test_every_answer_carries_the_security_headers(ui: Path) -> None:
+    async with client(ui) as http:
+        for method, path, headers, status, what in ANSWERS:
+            response = await http.request(method, path, headers=headers)
+            assert response.status_code == status, (what, method, path, response.text)
+            assert_secured(response)
+
+
+@asyncio_test
+async def test_a_streamed_turn_carries_the_security_headers(ui: Path) -> None:
+    async with client(ui) as http:
+        started = await http.post("/api/turns", json={"agent_id": "echo", "text": "hello"})
+        assert started.status_code == 200, started.text
+        assert started.headers["content-type"].startswith("text/event-stream")
+        assert_secured(started)
+
+
+@asyncio_test
+async def test_the_placeholder_page_carries_the_security_headers(tmp_path: Path) -> None:
+    # A checkout that has not built the interface answers /ui/ from a route instead.
+    async with client(tmp_path / "not-built") as http:
+        response = await http.get("/ui/")
+        assert response.status_code == 200
+        assert "not built" in response.text
+        assert_secured(response)

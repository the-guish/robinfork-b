From: Claude <noreply@anthropic.com>
Date: Sat, 10 Oct 2026 18:06:33 +0000
Subject: [PATCH] Test that every HTTP answer carries the security headers

An API test asks the server for the interface's page, a file the
interface lacks, the redirect to it, an API answer, and refusals from
each layer: a missing conversation, a malformed id, an unknown route and
a cross-site request the guard turns away. Each answer must carry every
header of SECURITY_HEADERS with its value. It fails, all eight cases,
when the SecurityHeaders middleware is removed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01WSoiAd58tv7xx9VJhmGiyF
Signed-off-by: Claude <noreply@anthropic.com>
---
 backend/tests/api/test_security_headers.py | 45 ++++++++++++++++++++++
 1 file changed, 45 insertions(+)
 create mode 100644 backend/tests/api/test_security_headers.py

diff --git a/backend/tests/api/test_security_headers.py b/backend/tests/api/test_security_headers.py
new file mode 100644
index 0000000..3e46142
--- /dev/null
+++ b/backend/tests/api/test_security_headers.py
@@ -0,0 +1,45 @@
+# SPDX-License-Identifier: Apache-2.0
+# Copyright The Robinauts Authors
+
+"""Every HTTP answer carries the security headers: the interface's files, the API's answers
+and its refusals, whichever layer refuses. A browser shows none of them, so the UI cannot."""
+
+from __future__ import annotations
+
+import uuid
+
+import httpx
+import pytest
+
+from robinauts.web.headers import SECURITY_HEADERS
+from util.controller_db import requires_postgres
+
+pytestmark = requires_postgres
+
+ANSWERS = {
+    "the interface's page": ("GET", "/ui/", {}, 200),
+    "a file the interface lacks": ("GET", "/ui/no-such-file.js", {}, 404),
+    "the way to the interface": ("GET", "/", {}, 307),
+    "an API answer": ("GET", "/api/agents", {}, 200),
+    "a conversation that is not there": ("GET", f"/api/conversations/{uuid.uuid4()}", {}, 404),
+    "a malformed id": ("GET", "/api/conversations/not-an-id", {}, 422),
+    "a route that is not there": ("GET", "/api/no-such-route", {}, 404),
+    "a request from another site": (
+        "POST",
+        "/api/turns",
+        {"origin": "https://elsewhere.example"},
+        403,
+    ),
+}
+
+
+@pytest.mark.parametrize(
+    ("method", "path", "headers", "status"), ANSWERS.values(), ids=ANSWERS.keys()
+)
+def test_every_answer_carries_the_security_headers(
+    api: httpx.Client, method: str, path: str, headers: dict[str, str], status: int
+) -> None:
+    answer = api.request(method, path, headers=headers)
+    assert answer.status_code == status, answer.text
+    for name, value in SECURITY_HEADERS:
+        assert answer.headers.get(name) == value, name
